# Configuração do Banco de Dados
# Para local/Docker: postgresql+psycopg2://<usuario>:<senha>@<host>:<porta>/<banco>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tech4um

# Chave secreta para criptografia de tokens JWT
# DICA: Gere uma usando `openssl rand -hex 32`
SECRET_KEY=change-this-secret-key-to-something-secure-in-production

# Tempo de expiração do Token de Acesso em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens permitidas para o CORS (separadas por vírgula)
# Em produção, coloque o endereço exato do seu frontend Vercel (ex: https://tech4um.vercel.app)
ALLOWED_ORIGINS=*

# Configuração do Redis (em produção utilizaremos redis cloud)
REDIS_URL=redis://localhost:6379/0
